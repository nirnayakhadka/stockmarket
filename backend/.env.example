# Database (SQLite by default so it runs with zero setup; swap to Postgres for prod)
# Example for Postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nepse_db

SECRET_KEY=acsjahicjiajopcakopsc
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Crawling
CRAWL_DELAY_SECONDS=2.0
USER_AGENT=NepseNewsCrawlerBot/1.0 (+mailto:you@example.com)
REQUEST_TIMEOUT_SECONDS=15

# Scheduler
ENABLE_SCHEDULER=true
CRAWL_SCHEDULE_CRON_HOUR=6,12,18

# Live market sync (replaces seeding - runs at startup + on interval)
ENABLE_STARTUP_MARKET_SYNC=true
MARKET_SYNC_INTERVAL_MINUTES=5
FLOORSHEET_MAX_PAGES=2